// Dealbook - Sales Dashboard MVP
// Minimal schema for call prep feature

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== AUTHENTICATION ====================

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  emailVerified     DateTime?         @map("email_verified")
  name              String?
  image             String?
  role              String            @default("sales_engineer") // 'admin', 'presales_lead', 'sales_engineer'

  // NextAuth Relations
  accounts          Account[]
  sessions          Session[]

  // Core features
  deals             Deal[]
  contacts          Contact[]
  calls             Call[]
  calendarEvents    CalendarEvent[]
  todos             Todo[]
  activityLogs      ActivityLog[]
  preferences       UserPreference?
  links             Link[]

  // Deal Assignments
  seAssignments     DealAssignment[] @relation("assignedSE")    // Deals assigned to this SE
  managerAssignments DealAssignment[] @relation("assignedBy")   // Assignments made by this manager

  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([email])
  @@map("users")
}

model Account {
  id                        String  @id @default(cuid())
  userId                    Int
  type                      String
  provider                  String
  providerAccountId         String
  refresh_token             String?  @db.Text
  access_token              String?  @db.Text
  expires_at                Int?
  token_type                String?
  scope                     String?
  id_token                  String?  @db.Text
  session_state             String?
  refresh_token_expires_in  Int?

  user                      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ==================== CORE MODELS ====================

model Deal {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  name              String    @db.VarChar(255)
  email             String?   @db.VarChar(255)
  leadSource        String?   @db.VarChar(100) @map("lead_source")
  amount            Decimal?  @db.Decimal(12, 2)
  status            String?   @db.VarChar(50) // 'active', 'closed', 'on_hold', 'lost'
  stage             String?   @db.VarChar(50) // 'demo', 'poc', 'validation', 'closed'
  probability       Int       @default(50) // 0-100
  expectedCloseDate DateTime? @map("expected_close_date")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastActivityAt    DateTime? @map("last_activity_at")

  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts          Contact[]
  calls             Call[]
  calendarEvents    CalendarEvent[]
  todos             Todo[]
  activityLogs      ActivityLog[]
  assignments       DealAssignment[]  // SEs assigned to this deal

  @@index([userId])
  @@map("deals")
}

model Contact {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  dealId          Int       @map("deal_id")
  name            String    @db.VarChar(255)
  email           String    @db.VarChar(255)
  title           String?   @db.VarChar(255)
  role            String?   @db.VarChar(100) // 'decision_maker', 'influencer', 'technical_buyer', 'economic_buyer'
  company         String?   @db.VarChar(255)
  linkedinUrl     String?   @db.VarChar(255) @map("linkedin_url")
  notes           String?   @db.Text
  lastContactedAt DateTime? @map("last_contacted_at")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal            Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, email])
  @@index([userId])
  @@index([dealId])
  @@map("contacts")
}

model CalendarEvent {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  dealId          Int?      @map("deal_id")
  title           String    @db.VarChar(255)
  startTime       DateTime  @map("start_time")
  endTime         DateTime  @map("end_time")
  attendees       String[]  @default([])
  description     String?   @db.Text

  // Google Calendar integration
  googleEventId   String?   @unique @map("google_event_id")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal            Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dealId])
  @@index([googleEventId])
  @@map("calendar_events")
}

model Call {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  dealId          Int       @map("deal_id")
  title           String    @db.VarChar(255)
  callDate        DateTime  @map("call_date")
  durationMinutes Int?      @map("duration_minutes")
  attendees       String[]  @default([])
  notes           String?   @db.Text

  // Gong integration
  gongCallId      String?   @db.VarChar(255) @unique @map("gong_call_id")
  gongSummary     String?   @db.Text @map("gong_summary")
  gongRiskLevel   String?   @db.VarChar(50) @map("gong_risk_level")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal            Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dealId])
  @@map("calls")
}

model Todo {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  content   String    @db.Text
  dealId    Int?      @map("deal_id")
  completed Boolean   @default(false)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dealId])
  @@map("todos")
}

model ActivityLog {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  dealId      Int?      @map("deal_id")
  action      String    @db.VarChar(100)
  description String?   @db.Text
  metadata    Json?

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dealId])
  @@map("activity_logs")
}

model UserPreference {
  id                      Int       @id @default(autoincrement())
  userId                  Int       @unique @map("user_id")

  // ===== PROFILE & ACCOUNT =====
  timezonePrimary         String    @default("UTC") @db.VarChar(50) @map("timezone_primary")
  timezoneSecondary       String?   @db.VarChar(50) @map("timezone_secondary")
  language                String    @default("en") @db.VarChar(10)

  // ===== PERSONALIZATION =====
  theme                   String    @default("paper") @db.VarChar(50) // paper, cobalt, emerald
  fontFamily              String    @default("dm-sans") @db.VarChar(50) @map("font_family") // dm-sans, inter, poppins, outfit
  clockType               String    @default("digital") @db.VarChar(50) @map("clock_type") // digital, analog, both, minimal
  density                 String    @default("normal") @db.VarChar(50) // compact, normal, spacious
  dealViewType            String    @default("kanban") @db.VarChar(50) @map("deal_view_type") // kanban, list, grid
  colorBlindMode          String?   @db.VarChar(50) @map("color_blind_mode") // protanopia, deuteranopia, tritanopia
  darkMode                Boolean   @default(false) @map("dark_mode")

  // ===== NOTIFICATIONS =====
  notificationPreferences Json      @default("{\"email\": {\"default\": \"mentions\", \"quietHours\": null, \"digestFrequency\": \"daily\"}, \"slack\": {\"default\": \"mentions\", \"connected\": false}, \"inApp\": {\"enabled\": true, \"sound\": true}}") @map("notification_preferences")

  // ===== DEAL HEALTH METRICS (Custom Thresholds) =====
  dealHealthMetrics       Json      @default("{\"activityVelocity\": {\"critical\": 3, \"warning\": 7}, \"timeline\": {\"overdueDays\": 0, \"warningDays\": 7}, \"engagement\": {\"criticalDays\": 5, \"warningDays\": 14, \"minContacts\": 1}, \"probability\": {\"high\": 70, \"medium\": 30}, \"weights\": {\"activity\": 40, \"sentiment\": 35, \"engagement\": 25}}") @map("deal_health_metrics")

  // ===== RISK FLAGS =====
  riskFlags               Json      @default("{\"noActivity\": true, \"overdue\": true, \"noContact\": true, \"lowProbability\": true, \"approvalPending\": true}") @map("risk_flags")
  notifyOnCritical        Boolean   @default(true) @map("notify_on_critical")

  // ===== INTEGRATIONS & SYNC =====
  googleCalendarToken     String?   @db.Text @map("google_calendar_token")
  googleCalendarRefreshToken String? @db.Text @map("google_calendar_refresh_token")
  gmailToken              String?   @db.Text @map("gmail_token")
  gmailRefreshToken       String?   @db.Text @map("gmail_refresh_token")

  // Integration configuration (which features are enabled)
  integrationSettings     Json      @default("{\"google\": {\"connected\": false, \"syncCalls\": false, \"syncEmails\": false}, \"slack\": {\"connected\": false, \"dealUpdates\": false, \"callAlerts\": false}, \"anthropic\": {\"connected\": false, \"generateInsights\": false}, \"salesforce\": {\"connected\": false, \"bidirectionalSync\": false}}") @map("integration_settings")

  // ===== AI PERMISSIONS (Claude) =====
  aiPermissions           Json      @default("{\"allowRead\": [\"calls\", \"deals\", \"emails\"], \"blockRead\": []}") @map("ai_permissions")

  // Last sync times
  lastGmailSyncAt         DateTime? @map("last_gmail_sync_at")
  lastCalendarSyncAt      DateTime? @map("last_calendar_sync_at")

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relations
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ==================== LINK HUB ====================

model Link {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  title       String    @db.VarChar(255)
  url         String    @db.Text
  description String?   @db.Text
  category    String    @default("general") @db.VarChar(100)
  linkType    String    @map("link_type") // 'internal', 'public'

  // Public sharing
  isPublic    Boolean   @default(false) @map("is_public")
  publicToken String?   @unique @map("public_token")
  expiresAt   DateTime? @map("expires_at")

  // Analytics
  copyCount   Int       @default(0) @map("copy_count")
  viewCount   Int       @default(0) @map("view_count")
  lastCopiedAt DateTime? @map("last_copied_at")
  lastViewedAt DateTime? @map("last_viewed_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([publicToken])
  @@map("links")
}

// ==================== DEAL ASSIGNMENTS ====================

model DealAssignment {
  id                Int       @id @default(autoincrement())
  dealId            Int       @map("deal_id")
  seUserId          Int       @map("se_user_id")
  assignedByUserId  Int       @map("assigned_by_user_id")
  assignedAt        DateTime  @default(now()) @map("assigned_at")

  deal              Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  seUser            User      @relation("assignedSE", fields: [seUserId], references: [id], onDelete: Cascade)
  assignedByUser    User      @relation("assignedBy", fields: [assignedByUserId], references: [id], onDelete: Cascade)

  @@unique([dealId, seUserId])
  @@index([dealId])
  @@index([seUserId])
  @@map("deal_assignments")
}
