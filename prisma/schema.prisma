// Dealbook - Sales Dashboard MVP
// Minimal schema for call prep feature

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== AUTHENTICATION ====================

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  emailVerified     DateTime?         @map("email_verified")
  name              String?
  image             String?
  role              String            @default("sales_engineer") // 'admin', 'presales_lead', 'sales_engineer'

  // NextAuth Relations
  accounts          Account[]
  sessions          Session[]

  // Core features
  deals             Deal[]
  contacts          Contact[]
  calls             Call[]
  todos             Todo[]
  activityLogs      ActivityLog[]
  preferences       UserPreference?
  links             Link[]

  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([email])
  @@map("users")
}

model Account {
  id                        String  @id @default(cuid())
  userId                    Int
  type                      String
  provider                  String
  providerAccountId         String
  refresh_token             String?  @db.Text
  access_token              String?  @db.Text
  expires_at                Int?
  token_type                String?
  scope                     String?
  id_token                  String?  @db.Text
  session_state             String?
  refresh_token_expires_in  Int?

  user                      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ==================== CORE MODELS ====================

model Deal {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  name              String    @db.VarChar(255)
  email             String?   @db.VarChar(255)
  leadSource        String?   @db.VarChar(100) @map("lead_source")
  amount            Decimal?  @db.Decimal(12, 2)
  status            String?   @db.VarChar(50) // 'active', 'closed', 'on_hold', 'lost'
  stage             String?   @db.VarChar(50) // 'demo', 'poc', 'validation', 'closed'
  probability       Int       @default(50) // 0-100
  expectedCloseDate DateTime? @map("expected_close_date")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastActivityAt    DateTime? @map("last_activity_at")

  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts          Contact[]
  calls             Call[]
  todos             Todo[]
  activityLogs      ActivityLog[]

  @@index([userId])
  @@map("deals")
}

model Contact {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  dealId          Int       @map("deal_id")
  name            String    @db.VarChar(255)
  email           String    @db.VarChar(255)
  title           String?   @db.VarChar(255)
  role            String?   @db.VarChar(100) // 'decision_maker', 'influencer', 'technical_buyer', 'economic_buyer'
  company         String?   @db.VarChar(255)
  linkedinUrl     String?   @db.VarChar(255) @map("linkedin_url")
  notes           String?   @db.Text
  lastContactedAt DateTime? @map("last_contacted_at")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal            Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, email])
  @@index([userId])
  @@index([dealId])
  @@map("contacts")
}

model Call {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  dealId          Int       @map("deal_id")
  title           String    @db.VarChar(255)
  callDate        DateTime  @map("call_date")
  durationMinutes Int?      @map("duration_minutes")
  attendees       String[]  @default([])
  notes           String?   @db.Text

  // Gong integration
  gongCallId      String?   @db.VarChar(255) @unique @map("gong_call_id")
  gongSummary     String?   @db.Text @map("gong_summary")
  gongRiskLevel   String?   @db.VarChar(50) @map("gong_risk_level")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal            Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([dealId])
  @@map("calls")
}

model Todo {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  content   String    @db.Text
  dealId    Int?      @map("deal_id")
  completed Boolean   @default(false)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal      Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dealId])
  @@map("todos")
}

model ActivityLog {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  dealId      Int?      @map("deal_id")
  action      String    @db.VarChar(100)
  description String?   @db.Text
  metadata    Json?

  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dealId])
  @@map("activity_logs")
}

model UserPreference {
  id                      Int       @id @default(autoincrement())
  userId                  Int       @unique @map("user_id")
  timezonePrimary         String    @default("UTC") @db.VarChar(50) @map("timezone_primary")
  timezoneSecondary       String?   @db.VarChar(50) @map("timezone_secondary")
  googleCalendarToken     String?   @db.Text @map("google_calendar_token")
  googleCalendarRefreshToken String? @db.Text @map("google_calendar_refresh_token")

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relations
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ==================== LINK HUB ====================

model Link {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  title       String    @db.VarChar(255)
  url         String    @db.Text
  description String?   @db.Text
  category    String    @default("general") @db.VarChar(100)
  linkType    String    @map("link_type") // 'internal', 'public'

  // Public sharing
  isPublic    Boolean   @default(false) @map("is_public")
  publicToken String?   @unique @map("public_token")
  expiresAt   DateTime? @map("expires_at")

  // Analytics
  copyCount   Int       @default(0) @map("copy_count")
  viewCount   Int       @default(0) @map("view_count")
  lastCopiedAt DateTime? @map("last_copied_at")
  lastViewedAt DateTime? @map("last_viewed_at")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([publicToken])
  @@map("links")
}
